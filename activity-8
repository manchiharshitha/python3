
# MANUFACTURING COST AND PROFITABILITY ANALYSIS

products = []

n = int(input("Enter number of products: "))

for i in range(n):

    print("\nEnter Details of Product", i + 1)

    name = input("Enter product name: ")

    quantity = int(input("Enter production quantity: "))

    material_cost = float(input("Enter material cost per unit: "))

    labour_cost = float(input("Enter labour charge per unit: "))

    wastage_percent = float(input("Enter wastage percentage: "))

    machine_cost = float(input("Enter machine cost per unit: "))

    selling_price = float(input("Enter selling price per unit: "))

    profit_target = float(input("Enter expected profit percentage: "))

    # Validate input details

    if (quantity <= 0 or material_cost < 0 or
        labour_cost < 0 or wastage_percent < 0 or
        machine_cost < 0 or selling_price < 0 or
        wastage_percent > 100 or profit_target < 0):

        print("Invalid product details!")
        continue

    # Calculate material wastage cost

    wastage_cost = material_cost * wastage_percent / 100

    # Calculate total production cost per unit

    cost_per_unit = (material_cost + wastage_cost +
                     labour_cost + machine_cost)

    # Calculate total production cost

    total_cost = cost_per_unit * quantity

    # Calculate total sales revenue

    total_revenue = selling_price * quantity

    # Calculate profit

    profit = total_revenue - total_cost

    # Calculate profit percentage

    if total_cost > 0:
        profit_percent = (profit / total_cost) * 100
    else:
        profit_percent = 0

    # Check profit target

    if profit_percent >= profit_target:
        status = "Target Achieved"

    else:
        status = "Target Not Achieved"

    # Store product details

    products.append([
        name, quantity, material_cost, wastage_cost,
        labour_cost, machine_cost, cost_per_unit,
        total_cost, total_revenue, profit,
        profit_percent, status
    ])

    # Display product analysis

    print("\n========== PRODUCT COST REPORT ==========")

    print("Product Name:", name)
    print("Production Quantity:", quantity)

    print("Material Cost per Unit: Rs.", material_cost)
    print("Wastage Cost per Unit: Rs.", round(wastage_cost, 2))
    print("Labour Cost per Unit: Rs.", labour_cost)
    print("Machine Cost per Unit: Rs.", machine_cost)

    print("Production Cost per Unit: Rs.",
          round(cost_per_unit, 2))

    print("Total Production Cost: Rs.",
          round(total_cost, 2))

    print("Total Sales Revenue: Rs.",
          round(total_revenue, 2))

    print("Total Profit: Rs.", round(profit, 2))

    print("Profit Percentage:",
          round(profit_percent, 2), "%")

    print("Profit Target Status:", status)


# Display final production summary

print("\n========== MANUFACTURING SUMMARY ==========")

if len(products) == 0:
    print("No valid product records found.")

else:
    for product in products:

        print("\nProduct:", product[0])
        print("Total Cost: Rs.", round(product[7], 2))
        print("Total Revenue: Rs.", round(product[8], 2))
        print("Profit: Rs.", round(product[9], 2))
        print("Profit Percentage:", round(product[10], 2), "%")
        print("Status:", product[11])

print("\nManufacturing Analysis Completed!")
