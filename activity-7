
# RETAIL BILLING WITH MULTIPLE DISCOUNT RULES

products = []

n = int(input("Enter number of products: "))

subtotal = 0
total_tax = 0
total_discount = 0

for i in range(n):

    print("\nEnter Details of Product", i + 1)

    name = input("Enter product name: ")

    print("\nSelect Product Category")
    print("1. Electronics")
    print("2. Clothing")
    print("3. Food Items")

    category = int(input("Enter category choice: "))

    price = float(input("Enter price per unit: "))
    quantity = int(input("Enter quantity: "))

    # Validate product details

    if price < 0 or quantity <= 0:
        print("Invalid product details!")
        continue

    # Category-specific tax

    if category == 1:
        category_name = "Electronics"
        tax_rate = 18

    elif category == 2:
        category_name = "Clothing"
        tax_rate = 5

    elif category == 3:
        category_name = "Food Items"
        tax_rate = 3

    else:
        print("Invalid category!")
        continue

    # Calculate product amount

    amount = price * quantity

    # Calculate threshold discount

    if amount >= 10000:
        discount = amount * 0.15

    elif amount >= 5000:
        discount = amount * 0.10

    elif amount >= 2000:
        discount = amount * 0.05

    else:
        discount = 0

    # Maximum discount limit

    if discount > 2000:
        discount = 2000

    # Calculate tax after discount

    taxable_amount = amount - discount
    tax = taxable_amount * tax_rate / 100

    # Calculate final product amount

    final_amount = taxable_amount + tax

    # Update bill totals

    subtotal = subtotal + amount
    total_discount = total_discount + discount
    total_tax = total_tax + tax

    # Store product details

    products.append([
        name, category_name, price, quantity,
        amount, discount, tax, final_amount
    ])

# Calculate final bill

grand_total = subtotal - total_discount + total_tax

# Display itemized invoice

print("\n==========================================")
print("             RETAIL INVOICE")
print("==========================================")

for product in products:

    print("\nProduct Name:", product[0])
    print("Category:", product[1])
    print("Price per Unit: Rs.", product[2])
    print("Quantity:", product[3])
    print("Product Amount: Rs.", round(product[4], 2))
    print("Discount: Rs.", round(product[5], 2))
    print("Tax: Rs.", round(product[6], 2))
    print("Final Amount: Rs.", round(product[7], 2))

print("\n==========================================")
print("Subtotal: Rs.", round(subtotal, 2))
print("Total Discount: Rs.", round(total_discount, 2))
print("Total Tax: Rs.", round(total_tax, 2))
print("------------------------------------------")
print("GRAND TOTAL: Rs.", round(grand_total, 2))
print("==========================================")

print("\nThank you for shopping!")
