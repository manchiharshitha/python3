
# PROGRESSIVE ELECTRICITY BILLING SYSTEM

bills = []
months = []

n = int(input("Enter number of months: "))

for i in range(n):

    print("\nEnter details for Month", i + 1)

    month = input("Enter month name: ")
    units = int(input("Enter electricity units consumed: "))

    # Calculate electricity charges using slabs

    if units <= 100:
        amount = units * 2

    elif units <= 200:
        amount = (100 * 2) + (units - 100) * 3

    elif units <= 300:
        amount = (100 * 2) + (100 * 3) + (units - 200) * 5

    else:
        amount = (100 * 2) + (100 * 3) + (100 * 5) + (units - 300) * 7

    # Fixed charges
    fixed_charge = 50

    # Surcharge
    surcharge = amount * 0.05

    # Rebate for low consumption
    if units <= 100:
        rebate = amount * 0.10
    else:
        rebate = 0

    # Final bill calculation
    total_bill = amount + fixed_charge + surcharge - rebate

    months.append(month)
    bills.append(total_bill)

    print("\nElectricity Bill Details")
    print("Month:", month)
    print("Units Consumed:", units)
    print("Energy Charge:", amount)
    print("Fixed Charge:", fixed_charge)
    print("Surcharge:", round(surcharge, 2))
    print("Rebate:", round(rebate, 2))
    print("Total Bill: Rs.", round(total_bill, 2))


# Compare bills across months

print("\n===== MONTHLY BILL COMPARISON =====")

for i in range(n):

    print(months[i], ": Rs.", round(bills[i], 2))

# Identify unusual increases

print("\n===== UNUSUAL BILL INCREASES =====")

found = False

for i in range(1, n):

    increase = bills[i] - bills[i - 1]

    if increase > 0:
        percentage = (increase / bills[i - 1]) * 100

        if percentage > 50:
            print("Warning:", months[i],
                  "has an unusual increase of",
                  round(percentage, 2), "%")

            found = True

if found == False:
    print("No unusual bill increases found.")

print("\nElectricity Billing Completed!")
